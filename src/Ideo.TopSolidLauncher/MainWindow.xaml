<Window x:Class="Ideo.TopSolidLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Launcher TopSolid" Height="540" Width="820"
        MinHeight="440" MinWidth="680"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BackgroundBrush}">
    <Window.Resources>
        <Style TargetType="Button">
            <Setter Property="Background" Value="{StaticResource PrimaryBrush}" />
            <Setter Property="Foreground" Value="White" />
            <Setter Property="BorderThickness" Value="0" />
            <Setter Property="Padding" Value="18,10" />
            <Setter Property="FontWeight" Value="SemiBold" />
            <Setter Property="Cursor" Value="Hand" />
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border Background="{TemplateBinding Background}" CornerRadius="7" Padding="{TemplateBinding Padding}">
                            <ContentPresenter HorizontalAlignment="Center" VerticalAlignment="Center" />
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
            <Style.Triggers>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="Background" Value="{StaticResource PrimaryDarkBrush}" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Margin="32">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Grid>
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*" />
                <ColumnDefinition Width="Auto" />
            </Grid.ColumnDefinitions>
            <StackPanel>
                <TextBlock Text="Launcher TopSolid" FontSize="28" FontWeight="Bold" Foreground="{StaticResource TextBrush}" />
                <TextBlock Text="Choisissez la version à démarrer" Margin="0,5,0,0" FontSize="14" Foreground="{StaticResource MutedBrush}" />
            </StackPanel>
            <StackPanel Grid.Column="1" Orientation="Horizontal" VerticalAlignment="Center">
                <Button x:Name="UpdateButton" Content="Mise à jour" Click="CheckUpdate_Click" Margin="0,0,10,0" />
                <Button Content="Ouvrir le journal" Click="OpenLog_Click" Margin="0,0,10,0" />
                <Button Content="Actualiser" Click="Refresh_Click" />
            </StackPanel>
        </Grid>

        <Border Grid.Row="1" Margin="0,24,0,16" Padding="14,10" Background="#E7F3FC" CornerRadius="7">
            <TextBlock x:Name="StatusText" Text="Recherche des installations…" Foreground="#075F9E" />
        </Border>

        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto">
            <ItemsControl x:Name="InstallationsList">
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}" CornerRadius="10" Padding="20" Margin="0,0,0,12">
                            <Border.Effect>
                                <DropShadowEffect BlurRadius="12" ShadowDepth="1" Opacity="0.10" />
                            </Border.Effect>
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="*" />
                                    <ColumnDefinition Width="Auto" />
                                </Grid.ColumnDefinitions>
                                <StackPanel>
                                    <TextBlock Text="{Binding DisplayName}" FontSize="20" FontWeight="SemiBold" Foreground="{StaticResource TextBrush}" />
                                    <TextBlock Text="{Binding CommandLine}" Margin="0,6,0,0" FontSize="12" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" ToolTip="{Binding CommandLine}" />
                                </StackPanel>
                                <Button Grid.Column="1" Content="Lancer" Tag="{Binding}" Click="Launch_Click" Margin="20,0,0,0" VerticalAlignment="Center" />
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <Grid Grid.Row="3" Margin="0,12,0,0">
            <TextBlock Foreground="{StaticResource MutedBrush}" FontSize="12"
                       Text="Chaque clic démarre une nouvelle instance. Le launcher se réduit dans la barre des tâches." />
            <TextBlock x:Name="VersionText" HorizontalAlignment="Right" Foreground="{StaticResource MutedBrush}" FontSize="12" />
        </Grid>
    </Grid>
</Window>
