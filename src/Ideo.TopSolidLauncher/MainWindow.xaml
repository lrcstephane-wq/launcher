<Window x:Class="Ideo.TopSolidLauncher.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Idéo Launcher" Width="1280" Height="820" MinWidth="980" MinHeight="650"
        WindowStartupLocation="CenterScreen" Closing="Window_Closing" KeyDown="MainWindow_KeyDown">
    <Window.Resources>
        <Style x:Key="SidebarHeading" TargetType="TextBlock">
            <Setter Property="FontSize" Value="11" />
            <Setter Property="FontWeight" Value="Bold" />
            <Setter Property="Foreground" Value="#7F91A8" />
            <Setter Property="TextOptions.TextFormattingMode" Value="Display" />
        </Style>
        <Style x:Key="CardBorderStyle" TargetType="Border">
            <Setter Property="Width" Value="278" />
            <Setter Property="Height" Value="292" />
            <Setter Property="Margin" Value="0,0,14,14" />
            <Setter Property="Background" Value="#202C3B" />
            <Setter Property="BorderBrush" Value="#3B4A5E" />
            <Setter Property="BorderThickness" Value="1" />
            <Setter Property="CornerRadius" Value="14" />
            <Setter Property="Cursor" Value="Arrow" />
            <Style.Triggers>
                <DataTrigger Binding="{Binding DataContext.CompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                    <Setter Property="Height" Value="222" />
                </DataTrigger>
                <Trigger Property="IsMouseOver" Value="True">
                    <Setter Property="BorderBrush" Value="#55739A" />
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Grid Background="{StaticResource BackgroundBrush}">
        <Image Source="Assets/IdeoBackground.jpg" Stretch="UniformToFill" Opacity="0.12" IsHitTestVisible="False" />
        <Grid>
            <Grid.RowDefinitions>
                <RowDefinition Height="94" />
                <RowDefinition Height="*" />
                <RowDefinition Height="36" />
            </Grid.RowDefinitions>

            <Border Background="#E5151E2A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="24,0">
                <Grid>
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="235" />
                        <ColumnDefinition Width="*" />
                        <ColumnDefinition Width="Auto" />
                    </Grid.ColumnDefinitions>

                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Image Source="Assets/IdeoLogo.png" Width="142" Height="56" Stretch="Uniform" />
                        <Border Background="#2E69B3" CornerRadius="5" Padding="7,3" Margin="10,0,0,0" VerticalAlignment="Center">
                            <TextBlock Text="LAUNCHER" FontSize="9" FontWeight="Bold" />
                        </Border>
                    </StackPanel>

                    <Border Grid.Column="1" Background="#111A26" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="11" Height="46" MaxWidth="570" Margin="20,0" HorizontalAlignment="Stretch" VerticalAlignment="Center">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="42"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBlock Text="⌕" FontSize="24" Foreground="{StaticResource MutedBrush}" HorizontalAlignment="Center" VerticalAlignment="Center" />
                            <TextBox x:Name="SearchTextBox" Grid.Column="1" Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent"
                                     BorderThickness="0" Padding="0" FontSize="15" ToolTip="Rechercher un titre, un tag, une version ou une commande" />
                            <Button Grid.Column="2" Content="×" Style="{StaticResource GhostButton}" Click="ClearSearch_Click"
                                    ToolTip="Effacer la recherche" Margin="2" />
                        </Grid>
                    </Border>

                    <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                        <Button Content="+  Nouvelle carte" Click="NewCard_Click" Margin="0,0,9,0" />
                        <Button x:Name="UpdateButton" Content="Mise à jour" Click="CheckUpdate_Click"
                                Style="{StaticResource SecondaryButton}" Margin="0,0,9,0" />
                        <Button x:Name="SettingsButton" Content="•••" Width="48" Padding="0" Style="{StaticResource SecondaryButton}"
                                Click="OpenSettingsMenu_Click" ToolTip="Options">
                            <Button.ContextMenu>
                                <ContextMenu>
                                    <MenuItem Header="Gérer les tags" Click="ManageTags_Click" />
                                    <MenuItem Header="Ajouter un groupe" Click="AddGroup_Click" />
                                    <MenuItem Header="Détecter les versions TopSolid" Click="DetectTopSolid_Click" />
                                    <Separator />
                                    <MenuItem Header="Vue compacte" IsCheckable="True" Click="ToggleCompact_Click" />
                                    <Separator />
                                    <MenuItem Header="Recharger le catalogue" Click="ReloadCatalog_Click" />
                                    <MenuItem Header="Choisir un catalogue partagé…" Click="ChooseCatalog_Click" />
                                    <MenuItem Header="Importer un catalogue…" Click="ImportCatalog_Click" />
                                    <MenuItem Header="Restaurer une sauvegarde…" Click="RestoreBackup_Click" />
                                    <MenuItem Header="Exporter le catalogue…" Click="ExportCatalog_Click" />
                                    <MenuItem Header="Ouvrir le dossier du catalogue" Click="OpenCatalogFolder_Click" />
                                    <Separator />
                                    <MenuItem Header="Ouvrir le journal" Click="OpenLog_Click" />
                                </ContextMenu>
                            </Button.ContextMenu>
                        </Button>
                    </StackPanel>
                </Grid>
            </Border>

            <Grid Grid.Row="1">
                <Grid.ColumnDefinitions><ColumnDefinition Width="252"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>

                <Border Background="#C9141D29" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,1,0" Padding="18,20">
                    <ScrollViewer VerticalScrollBarVisibility="Auto">
                        <StackPanel>
                            <Grid Margin="2,0,2,14">
                                <TextBlock Text="FILTRES" Style="{StaticResource SidebarHeading}" VerticalAlignment="Center" />
                                <Button Content="Réinitialiser" HorizontalAlignment="Right" Style="{StaticResource GhostButton}"
                                        FontSize="11" Click="ClearFilters_Click" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding FilterCategories}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <StackPanel Margin="2,0,0,18">
                                            <TextBlock Text="{Binding Name}" FontSize="13" FontWeight="SemiBold" Margin="0,0,0,6" />
                                            <ItemsControl ItemsSource="{Binding Options}">
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <CheckBox IsChecked="{Binding IsSelected}" ToolTip="{Binding Description}">
                                                            <StackPanel Orientation="Horizontal">
                                                                <Border Width="8" Height="8" CornerRadius="4" Background="{Binding Color}" Margin="0,0,7,0" />
                                                                <TextBlock Text="{Binding Name}" Foreground="{StaticResource MutedBrush}" />
                                                            </StackPanel>
                                                        </CheckBox>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Separator Background="{StaticResource BorderBrush}" Margin="0,2,0,18" />
                            <Grid Margin="2,0,2,10">
                                <TextBlock Text="VUES ENREGISTRÉES" Style="{StaticResource SidebarHeading}" VerticalAlignment="Center" />
                                <Button Content="+" Width="30" Height="28" Padding="0" HorizontalAlignment="Right"
                                        Style="{StaticResource GhostButton}" Click="SaveView_Click" ToolTip="Enregistrer les filtres actuels" />
                            </Grid>
                            <ItemsControl ItemsSource="{Binding SavedViews}">
                                <ItemsControl.ItemTemplate>
                                    <DataTemplate>
                                        <Border Background="#182333" CornerRadius="8" Padding="8,4" Margin="0,0,0,5">
                                            <Grid>
                                                <Button Content="{Binding Name}" HorizontalContentAlignment="Left" Style="{StaticResource GhostButton}"
                                                        Padding="4" Click="ApplySavedView_Click" />
                                                <Button Content="×" HorizontalAlignment="Right" Style="{StaticResource GhostButton}"
                                                        Padding="6" Click="DeleteSavedView_Click" ToolTip="Supprimer cette vue" />
                                            </Grid>
                                        </Border>
                                    </DataTemplate>
                                </ItemsControl.ItemTemplate>
                            </ItemsControl>

                            <Border Background="#15263A" BorderBrush="#2B4E77" BorderThickness="1" CornerRadius="10" Padding="12" Margin="0,18,0,0">
                                <StackPanel>
                                    <TextBlock Text="Astuce" FontWeight="SemiBold" Foreground="#8BB9EF" />
                                    <TextBlock Text="Dans une catégorie : OU&#x0a;Entre catégories : ET"
                                               Margin="0,4,0,0" Foreground="{StaticResource MutedBrush}" FontSize="11" />
                                </StackPanel>
                            </Border>
                        </StackPanel>
                    </ScrollViewer>
                </Border>

                <Grid Grid.Column="1">
                    <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
                    <Grid Margin="26,18,28,14">
                        <StackPanel>
                            <TextBlock Text="Mes applications" FontSize="22" FontWeight="Bold" />
                            <TextBlock Text="{Binding CountLabel}" Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                        </StackPanel>
                        <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                            <TextBlock Text="Glissez les cartes pour les réorganiser" Foreground="#78899E" FontSize="11" Margin="0,0,14,0" VerticalAlignment="Center" />
                            <Button Content="+ Groupe" Style="{StaticResource SecondaryButton}" Click="AddGroup_Click" />
                        </StackPanel>
                    </Grid>

                    <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="26,0,14,18">
                        <ItemsControl ItemsSource="{Binding VisibleGroups}">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Border Background="#B316202D" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                            CornerRadius="15" Padding="18" Margin="0,0,10,18" AllowDrop="True"
                                            DragOver="Group_DragOver" Drop="Group_Drop">
                                        <StackPanel>
                                            <Grid Margin="0,0,0,14">
                                                <StackPanel Orientation="Horizontal">
                                                    <TextBlock Text="{Binding Name}" FontSize="18" FontWeight="SemiBold" />
                                                    <Border Background="#28374A" CornerRadius="7" Padding="8,3" Margin="10,0,0,0">
                                                        <TextBlock Text="{Binding CountLabel}" FontSize="10" Foreground="{StaticResource MutedBrush}" />
                                                    </Border>
                                                </StackPanel>
                                                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                                                    <Button Content="+ Ajouter" Style="{StaticResource GhostButton}" Click="NewCardInGroup_Click" />
                                                    <Button Content="•••" Style="{StaticResource GhostButton}" Click="OpenGroupMenu_Click">
                                                        <Button.ContextMenu>
                                                            <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                <MenuItem Header="Renommer le groupe" Click="RenameGroup_Click" />
                                                                <MenuItem Header="Monter le groupe" Click="MoveGroupUp_Click" />
                                                                <MenuItem Header="Descendre le groupe" Click="MoveGroupDown_Click" />
                                                                <Separator />
                                                                <MenuItem Header="Supprimer le groupe" Click="DeleteGroup_Click" />
                                                            </ContextMenu>
                                                        </Button.ContextMenu>
                                                    </Button>
                                                </StackPanel>
                                            </Grid>

                                            <ItemsControl ItemsSource="{Binding Cards}">
                                                <ItemsControl.ItemsPanel>
                                                    <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                                                </ItemsControl.ItemsPanel>
                                                <ItemsControl.ItemTemplate>
                                                    <DataTemplate>
                                                        <Border Style="{StaticResource CardBorderStyle}" AllowDrop="True"
                                                                PreviewMouseLeftButtonDown="Card_PreviewMouseLeftButtonDown"
                                                                MouseMove="Card_MouseMove" DragOver="Card_DragOver" Drop="Card_Drop">
                                                            <Border.Effect>
                                                                <DropShadowEffect BlurRadius="20" ShadowDepth="5" Opacity="0.23" Color="#05080C" />
                                                            </Border.Effect>
                                                            <Grid ClipToBounds="True">
                                                                <Grid.RowDefinitions>
                                                                    <RowDefinition Height="5"/><RowDefinition Height="*"/>
                                                                </Grid.RowDefinitions>
                                                                <Border Background="{Binding AccentColor}" CornerRadius="14,14,0,0" />
                                                                <Grid Grid.Row="1" Margin="16,13,16,14">
                                                                    <Grid.RowDefinitions>
                                                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/><RowDefinition Height="*"/>
                                                                        <RowDefinition Height="Auto"/><RowDefinition Height="Auto"/>
                                                                    </Grid.RowDefinitions>
                                                                    <Grid>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                                        <TextBlock Text="{Binding Title}" FontSize="17" FontWeight="SemiBold" TextTrimming="CharacterEllipsis"
                                                                                   ToolTip="{Binding Title}" VerticalAlignment="Center" />
                                                                        <Button Grid.Column="1" Content="{Binding FavoriteGlyph}" Style="{StaticResource GhostButton}"
                                                                                FontSize="19" Padding="5" Click="Favorite_Click" ToolTip="Ajouter/retirer des favoris" />
                                                                        <Button Grid.Column="2" Content="•••" Style="{StaticResource GhostButton}" Padding="5" Click="OpenCardMenu_Click">
                                                                            <Button.ContextMenu>
                                                                                <ContextMenu DataContext="{Binding PlacementTarget.DataContext, RelativeSource={RelativeSource Self}}">
                                                                                    <MenuItem Header="Modifier" Click="EditCard_Click" />
                                                                                    <MenuItem Header="Dupliquer" Click="DuplicateCard_Click" />
                                                                                    <Separator />
                                                                                    <MenuItem Header="Déplacer vers la gauche" Click="MoveCardUp_Click" />
                                                                                    <MenuItem Header="Déplacer vers la droite" Click="MoveCardDown_Click" />
                                                                                    <Separator />
                                                                                    <MenuItem Header="Supprimer" Click="DeleteCard_Click" />
                                                                                </ContextMenu>
                                                                            </Button.ContextMenu>
                                                                        </Button>
                                                                    </Grid>

                                                                    <Grid Grid.Row="1" Margin="0,10,0,8">
                                                                        <Grid.Style>
                                                                            <Style TargetType="Grid">
                                                                                <Setter Property="Visibility" Value="Visible" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding DataContext.CompactMode, RelativeSource={RelativeSource AncestorType=Window}}" Value="True">
                                                                                        <Setter Property="Visibility" Value="Collapsed" />
                                                                                    </DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </Grid.Style>
                                                                        <Grid.ColumnDefinitions><ColumnDefinition Width="58"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                                                                        <Border x:Name="LogoPanel" Width="50" Height="50" CornerRadius="11" Background="#121A25" Padding="7">
                                                                            <Image Source="{Binding LogoSource}" Stretch="Uniform" />
                                                                        </Border>
                                                                        <StackPanel Grid.Column="1" VerticalAlignment="Center" Margin="9,0,0,0">
                                                                            <TextBlock Text="{Binding Subtitle}" Foreground="{StaticResource MutedBrush}" TextTrimming="CharacterEllipsis" />
                                                                            <TextBlock Text="{Binding CommandLine}" Foreground="#71839A" FontSize="10" TextTrimming="CharacterEllipsis"
                                                                                       ToolTip="{Binding CommandLine}" Margin="0,4,0,0" />
                                                                        </StackPanel>
                                                                    </Grid>

                                                                    <ItemsControl Grid.Row="2" ItemsSource="{Binding Tags}" VerticalAlignment="Top">
                                                                        <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                                                                        <ItemsControl.ItemTemplate>
                                                                            <DataTemplate>
                                                                                <Border Background="{Binding Color}" CornerRadius="7" Padding="8,4" Margin="0,0,6,6"
                                                                                        ToolTip="{Binding Description}">
                                                                                    <TextBlock Text="{Binding Name}" FontSize="10" FontWeight="SemiBold" />
                                                                                </Border>
                                                                            </DataTemplate>
                                                                        </ItemsControl.ItemTemplate>
                                                                    </ItemsControl>

                                                                    <TextBlock Grid.Row="3" Text="{Binding ValidationMessage}" FontSize="10" Foreground="#7FB894" Margin="0,5,0,8">
                                                                        <TextBlock.Style>
                                                                            <Style TargetType="TextBlock">
                                                                                <Setter Property="Foreground" Value="#7FB894" />
                                                                                <Style.Triggers>
                                                                                    <DataTrigger Binding="{Binding IsValid}" Value="False"><Setter Property="Foreground" Value="#E0A35D" /></DataTrigger>
                                                                                </Style.Triggers>
                                                                            </Style>
                                                                        </TextBlock.Style>
                                                                    </TextBlock>
                                                                    <Button Grid.Row="4" Content="Lancer" IsEnabled="{Binding IsValid}" Click="LaunchCard_Click" />
                                                                </Grid>
                                                            </Grid>
                                                        </Border>
                                                    </DataTemplate>
                                                </ItemsControl.ItemTemplate>
                                            </ItemsControl>
                                        </StackPanel>
                                    </Border>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </ScrollViewer>
                </Grid>
            </Grid>

            <Border Grid.Row="2" Background="#E5151E2A" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="20,0">
                <Grid>
                    <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                    <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                        <TextBlock x:Name="CatalogLocationText" Foreground="#78899E" FontSize="10" VerticalAlignment="Center" Margin="0,0,18,0" />
                        <TextBlock x:Name="VersionText" Foreground="{StaticResource MutedBrush}" FontSize="11" VerticalAlignment="Center" />
                    </StackPanel>
                </Grid>
            </Border>
        </Grid>
    </Grid>
</Window>
