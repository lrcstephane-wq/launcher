<Window x:Class="Ideo.TopSolidLauncher.Views.TagEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Tag" Width="560" Height="520" MinWidth="520" MinHeight="500" ResizeMode="CanResize"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="26,18">
            <StackPanel>
                <TextBlock x:Name="HeadingText" Text="Nouveau tag" Style="{StaticResource DialogHeading}" />
                <TextBlock Text="Le tag apparaîtra sur les cartes et dans les filtres."
                           Foreground="{StaticResource MutedBrush}" Margin="0,4,0,0" />
            </StackPanel>
        </Border>

        <ScrollViewer Grid.Row="1" Background="{StaticResource BackgroundBrush}" VerticalScrollBarVisibility="Auto">
            <Border Style="{StaticResource SectionCard}" Margin="26,20">
                <StackPanel>
                    <TextBlock Text="Nom du tag *" Style="{StaticResource FieldLabel}" />
                    <TextBox x:Name="NameTextBox" MaxLength="40" />

                    <TextBlock Text="Catégorie *" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                    <TextBox x:Name="CategoryTextBox" MaxLength="40"
                             ToolTip="Exemples : Usage, Version, Chants, Année, Client" />

                    <TextBlock Text="Description facultative" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                    <TextBox x:Name="DescriptionTextBox" MaxLength="120" />

                    <TextBlock Text="Couleur" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions>
                            <ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="112"/>
                        </Grid.ColumnDefinitions>
                        <Border x:Name="ColorPreview" Width="42" Height="42" CornerRadius="8"
                                BorderBrush="#5B6D84" BorderThickness="1" />
                        <ComboBox x:Name="ColorComboBox" Grid.Column="1" Margin="8,0"
                                  SelectionChanged="ColorComboBox_Changed">
                            <ComboBox.ItemTemplate>
                                <DataTemplate>
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="14" Height="14" CornerRadius="4" Background="{Binding Hex}" Margin="0,0,8,0" />
                                        <TextBlock Text="{Binding Name}" />
                                    </StackPanel>
                                </DataTemplate>
                            </ComboBox.ItemTemplate>
                        </ComboBox>
                        <TextBox x:Name="ColorTextBox" Grid.Column="2" MaxLength="9"
                                 TextChanged="ColorTextBox_Changed" ToolTip="Code couleur #RRGGBB" />
                    </Grid>
                    <TextBlock x:Name="FormMessageText" Foreground="{StaticResource WarningBrush}" Margin="0,12,0,0" />
                </StackPanel>
            </Border>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource FooterBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="22,14">
            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                <Button Content="Annuler" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                <Button Content="Enregistrer" IsDefault="True" Click="Save_Click" />
            </StackPanel>
        </Border>
    </Grid>
</Window>
