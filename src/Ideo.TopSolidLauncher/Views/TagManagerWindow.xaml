<Window x:Class="Ideo.TopSolidLauncher.Views.TagManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion des tags" Width="760" Height="600" MinWidth="650" MinHeight="500"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>

        <Border Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="28,20">
            <Grid>
                <StackPanel>
                    <TextBlock Text="Tags et filtres" Style="{StaticResource DialogHeading}" />
                    <TextBlock Text="Dans une catégorie : OU. Entre les catégories : ET."
                               Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <Button Content="+  Nouveau tag" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Add_Click" />
            </Grid>
        </Border>

        <Grid Grid.Row="1" Margin="28,20">
            <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/></Grid.RowDefinitions>
            <Grid Margin="14,0,14,8">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="30"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/>
                    <ColumnDefinition Width="*"/><ColumnDefinition Width="150"/>
                </Grid.ColumnDefinitions>
                <TextBlock Grid.Column="1" Text="CATÉGORIE" Foreground="#7F91A8" FontSize="11" FontWeight="Bold" />
                <TextBlock Grid.Column="2" Text="TAG" Foreground="#7F91A8" FontSize="11" FontWeight="Bold" />
                <TextBlock Grid.Column="3" Text="DESCRIPTION" Foreground="#7F91A8" FontSize="11" FontWeight="Bold" />
            </Grid>
            <ListBox x:Name="TagsList" Grid.Row="1" Background="Transparent" BorderThickness="0"
                     ScrollViewer.VerticalScrollBarVisibility="Auto" HorizontalContentAlignment="Stretch">
                <ListBox.ItemContainerStyle>
                    <Style TargetType="ListBoxItem">
                        <Setter Property="HorizontalContentAlignment" Value="Stretch" />
                        <Setter Property="Background" Value="Transparent" />
                        <Setter Property="BorderThickness" Value="0" />
                        <Setter Property="Padding" Value="0" />
                        <Setter Property="Margin" Value="0" />
                        <Setter Property="Focusable" Value="False" />
                    </Style>
                </ListBox.ItemContainerStyle>
                <ListBox.ItemTemplate>
                    <DataTemplate>
                        <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                                CornerRadius="9" Padding="14,10" Margin="0,0,0,7">
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="30"/><ColumnDefinition Width="150"/><ColumnDefinition Width="150"/>
                                    <ColumnDefinition Width="*"/><ColumnDefinition Width="150"/>
                                </Grid.ColumnDefinitions>
                                <Border Width="10" Height="32" CornerRadius="5" Background="{Binding Color}"
                                        HorizontalAlignment="Left" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="1" Text="{Binding Category}" FontWeight="SemiBold" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{StaticResource TextBrush}" VerticalAlignment="Center" />
                                <TextBlock Grid.Column="3" Text="{Binding Description}" Foreground="{StaticResource MutedBrush}"
                                           TextTrimming="CharacterEllipsis" VerticalAlignment="Center" Margin="0,0,12,0" />
                                <StackPanel Grid.Column="4" Orientation="Horizontal" HorizontalAlignment="Right">
                                    <Button Content="Modifier" Style="{StaticResource GhostButton}" Click="Edit_Click" Margin="0,0,2,0" />
                                    <Button Content="Supprimer" Style="{StaticResource GhostButton}" Click="Delete_Click" />
                                </StackPanel>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ListBox.ItemTemplate>
            </ListBox>
        </Grid>

        <Border Grid.Row="2" Background="{StaticResource FooterBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="22,14">
            <Button Content="Terminer" HorizontalAlignment="Right" IsDefault="True" Click="Close_Click" />
        </Border>
    </Grid>
</Window>
