<Window x:Class="Ideo.TopSolidLauncher.Views.TagManagerWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Gestion des tags" Width="700" Height="570" MinWidth="600" MinHeight="480"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False">
    <Grid Margin="26">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Grid>
            <StackPanel>
                <TextBlock Text="Tags et filtres" FontSize="24" FontWeight="Bold" />
                <TextBlock Text="Les tags d'une même catégorie se combinent avec OU ; les catégories se combinent avec ET."
                           Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
            </StackPanel>
            <Button Content="+ Nouveau tag" HorizontalAlignment="Right" VerticalAlignment="Center" Click="Add_Click" />
        </Grid>

        <ListBox x:Name="TagsList" Grid.Row="1" Margin="0,22,0,18" Background="Transparent" BorderThickness="0"
                 ScrollViewer.VerticalScrollBarVisibility="Auto">
            <ListBox.ItemTemplate>
                <DataTemplate>
                    <Border Background="{StaticResource CardBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1"
                            CornerRadius="10" Padding="14" Margin="0,0,0,8" ToolTip="{Binding Description}">
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="150"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <Border Width="10" Height="36" CornerRadius="5" Background="{Binding Color}" />
                            <TextBlock Grid.Column="1" Text="{Binding Category}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="10,0" />
                            <TextBlock Grid.Column="2" Text="{Binding Name}" Foreground="{StaticResource MutedBrush}" VerticalAlignment="Center" />
                            <StackPanel Grid.Column="3" Orientation="Horizontal">
                                <Button Content="Modifier" Style="{StaticResource GhostButton}" Click="Edit_Click" Margin="0,0,4,0" />
                                <Button Content="Supprimer" Style="{StaticResource GhostButton}" Click="Delete_Click" />
                            </StackPanel>
                        </Grid>
                    </Border>
                </DataTemplate>
            </ListBox.ItemTemplate>
        </ListBox>

        <StackPanel Grid.Row="2" Orientation="Horizontal" HorizontalAlignment="Right">
            <Button Content="Terminer" IsDefault="True" Click="Close_Click" />
        </StackPanel>
    </Grid>
</Window>
