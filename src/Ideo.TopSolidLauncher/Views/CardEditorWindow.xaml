<Window x:Class="Ideo.TopSolidLauncher.Views.CardEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raccourci" Width="900" Height="780" MinWidth="760" MinHeight="650"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,0,0,1" Padding="28,20">
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="HeadingText" Text="Nouveau raccourci" Style="{StaticResource DialogHeading}" />
                    <TextBlock Text="Créez une carte, importez un .lnk ou déposez un dossier pour l’ajouter aux accès rapides."
                               Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <Button Content="Importer un .lnk" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource SecondaryButton}" Click="ImportShortcut_Click" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" Background="{StaticResource BackgroundBrush}"
                      VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
            <StackPanel Margin="28,22,28,26">
                <Border Style="{StaticResource SectionCard}">
                    <StackPanel>
                        <TextBlock Text="Informations" FontSize="17" FontWeight="SemiBold" />
                        <Grid Margin="0,15,0,0">
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="*" />
                                <ColumnDefinition Width="18" />
                                <ColumnDefinition Width="*" />
                            </Grid.ColumnDefinitions>
                            <Grid.RowDefinitions>
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                                <RowDefinition Height="Auto" />
                            </Grid.RowDefinitions>

                            <StackPanel Grid.ColumnSpan="3">
                                <TextBlock Text="Titre *" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="TitleTextBox" MaxLength="80" />
                            </StackPanel>
                            <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,14,0,0">
                                <TextBlock Text="Description courte" Style="{StaticResource FieldLabel}" />
                                <TextBox x:Name="SubtitleTextBox" MaxLength="120" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Margin="0,14,0,0">
                                <TextBlock Text="Groupe *" Style="{StaticResource FieldLabel}" />
                                <ComboBox x:Name="GroupComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" />
                            </StackPanel>
                            <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,14,0,0">
                                <TextBlock Text="Couleur d’accent" Style="{StaticResource FieldLabel}" />
                                <Grid>
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="44" />
                                        <ColumnDefinition Width="*" />
                                        <ColumnDefinition Width="104" />
                                    </Grid.ColumnDefinitions>
                                    <Border x:Name="ColorPreview" Width="42" Height="42" CornerRadius="8"
                                            BorderBrush="#5B6D84" BorderThickness="1" />
                                    <ComboBox x:Name="ColorComboBox" Grid.Column="1" Margin="8,0"
                                              SelectionChanged="ColorComboBox_Changed">
                                        <ComboBox.ItemTemplate>
                                            <DataTemplate>
                                                <StackPanel Orientation="Horizontal">
                                                    <Border Width="14" Height="14" CornerRadius="4" Background="{Binding Hex}" Margin="0,0,8,0" />
                                                    <TextBlock Text="{Binding Name}" />
                                                </StackPanel>
                                            </DataTemplate>
                                        </ComboBox.ItemTemplate>
                                    </ComboBox>
                                    <TextBox x:Name="ColorTextBox" Grid.Column="2" MaxLength="9"
                                             TextChanged="ColorTextBox_Changed" ToolTip="Code couleur #RRGGBB" />
                                </Grid>
                            </StackPanel>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid>
                            <StackPanel>
                                <TextBlock Text="Accès rapides" FontSize="17" FontWeight="SemiBold" />
                                <TextBlock Text="Ajoutez les dossiers utiles à cette carte : Cfg, Grp, documents, modèles…"
                                           Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <Button Content="+  Ajouter un dossier" HorizontalAlignment="Right" VerticalAlignment="Center"
                                    Style="{StaticResource SecondaryButton}" Click="AddQuickAccess_Click" />
                        </Grid>
                        <ItemsControl x:Name="QuickAccessItemsControl" Margin="0,14,0,0">
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="130"/><ColumnDefinition Width="10"/>
                                            <ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" MaxLength="24"
                                                 ToolTip="Nom affiché sur la carte, par exemple Cfg ou Grp" />
                                        <TextBox Grid.Column="2" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}"
                                                 ToolTip="Les variables Windows comme %USERNAME% sont acceptées" />
                                        <Button Grid.Column="3" Content="Parcourir" Style="{StaticResource SecondaryButton}"
                                                Margin="8,0,0,0" Click="BrowseQuickAccess_Click" />
                                        <Button Grid.Column="4" Content="×" Style="{StaticResource GhostButton}" FontSize="20"
                                                Width="40" Margin="4,0,0,0" Click="RemoveQuickAccess_Click" ToolTip="Retirer cet accès" />
                                    </Grid>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <TextBlock x:Name="NoQuickAccessText" Text="Aucun dossier ajouté."
                                   Foreground="#78899E" FontStyle="Italic" Margin="0,12,0,0" />
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Commande" FontSize="17" FontWeight="SemiBold" />
                        <StackPanel Margin="0,15,0,0">
                            <TextBlock Text="Cible *" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="TargetTextBox" />
                                <Button Grid.Column="1" Content="Parcourir" Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" Click="BrowseTarget_Click" />
                            </Grid>
                        </StackPanel>
                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="Arguments" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="ArgumentsTextBox" />
                        </StackPanel>
                        <StackPanel Margin="0,14,0,0">
                            <TextBlock Text="Dossier de travail" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="WorkingDirectoryTextBox" />
                        </StackPanel>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Apparence et classement" FontSize="17" FontWeight="SemiBold" />
                        <StackPanel Margin="0,15,0,0">
                            <TextBlock Text="Logo personnalisé" Style="{StaticResource FieldLabel}" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                <TextBox x:Name="LogoTextBox" />
                                <Button Grid.Column="1" Content="Parcourir" Style="{StaticResource SecondaryButton}"
                                        Margin="8,0,0,0" Click="BrowseLogo_Click" />
                            </Grid>
                        </StackPanel>
                        <TextBlock Text="Tags" FontWeight="SemiBold" Margin="0,18,0,3" />
                        <TextBlock Text="Plusieurs tags peuvent être associés à la même carte."
                                   Foreground="{StaticResource MutedBrush}" Margin="0,0,0,10" />
                        <ItemsControl x:Name="TagsItemsControl">
                            <ItemsControl.ItemsPanel>
                                <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                            </ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate>
                                <DataTemplate>
                                    <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,20,8">
                                        <StackPanel Orientation="Horizontal">
                                            <Border Width="9" Height="9" CornerRadius="5" Background="{Binding Tag.Color}" Margin="0,0,7,0" />
                                            <TextBlock Text="{Binding Display}" Foreground="{StaticResource TextBrush}" />
                                        </StackPanel>
                                    </CheckBox>
                                </DataTemplate>
                            </ItemsControl.ItemTemplate>
                        </ItemsControl>
                        <Separator Margin="0,10" Background="{StaticResource BorderBrush}" />
                        <CheckBox x:Name="RunAsAdminCheckBox" Content="Exécuter en tant qu’administrateur" />
                        <CheckBox x:Name="MinimizeCheckBox" Content="Réduire le launcher après le lancement" IsChecked="True" />
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource FooterBrush}" BorderBrush="{StaticResource BorderBrush}"
                BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Tester la commande" Style="{StaticResource SecondaryButton}" Click="Test_Click" />
                    <TextBlock x:Name="FormMessageText" Foreground="{StaticResource WarningBrush}"
                               VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                    <Button Content="Enregistrer" IsDefault="True" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
