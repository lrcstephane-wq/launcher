<Window x:Class="Ideo.TopSolidLauncher.Views.CardEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raccourci" Width="1040" Height="850" MinWidth="920" MinHeight="690"
        Background="{StaticResource BackgroundBrush}" Foreground="{StaticResource TextBrush}"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False" AllowDrop="True"
        DragOver="Window_DragOver" Drop="Window_Drop">
    <Grid Background="{StaticResource BackgroundBrush}">
        <Grid.RowDefinitions><RowDefinition Height="Auto"/><RowDefinition Height="*"/><RowDefinition Height="Auto"/></Grid.RowDefinitions>
        <Border Background="{StaticResource HeaderBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="28,20">
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="HeadingText" Text="Nouveau raccourci" Style="{StaticResource DialogHeading}" />
                    <TextBlock Text="Une carte peut proposer autant de modes de lancement que nécessaire." Foreground="{StaticResource MutedBrush}" Margin="0,5,0,0" />
                </StackPanel>
                <Button Content="Importer un raccourci .lnk" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource SecondaryButton}" Click="ImportShortcut_Click" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="28,20">
            <StackPanel>
                <Border Style="{StaticResource SectionCard}">
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                        <StackPanel>
                            <TextBlock Text="Titre *" Style="{StaticResource FieldLabel}" />
                            <TextBox x:Name="TitleTextBox" MaxLength="80" />
                            <TextBlock Text="Description" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                            <TextBox x:Name="SubtitleTextBox" MaxLength="120" />
                        </StackPanel>
                        <StackPanel Grid.Column="2">
                            <TextBlock Text="Groupe" Style="{StaticResource FieldLabel}" />
                            <ComboBox x:Name="GroupComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" />
                            <TextBlock Text="Couleur d’accent" Style="{StaticResource FieldLabel}" Margin="0,14,0,6" />
                            <Grid>
                                <Grid.ColumnDefinitions><ColumnDefinition Width="44"/><ColumnDefinition Width="*"/><ColumnDefinition Width="110"/></Grid.ColumnDefinitions>
                                <Border x:Name="ColorPreview" Width="42" Height="42" CornerRadius="8" BorderBrush="#5B6D84" BorderThickness="1" />
                                <ComboBox x:Name="ColorComboBox" Grid.Column="1" Margin="8,0" SelectionChanged="ColorComboBox_Changed">
                                    <ComboBox.ItemTemplate><DataTemplate><StackPanel Orientation="Horizontal"><Border Width="14" Height="14" CornerRadius="4" Background="{Binding Hex}" Margin="0,0,8,0"/><TextBlock Text="{Binding Name}"/></StackPanel></DataTemplate></ComboBox.ItemTemplate>
                                </ComboBox>
                                <TextBox x:Name="ColorTextBox" Grid.Column="2" MaxLength="9" TextChanged="ColorTextBox_Changed" />
                            </Grid>
                        </StackPanel>
                    </Grid>
                </Border>

                <Border Style="{StaticResource SectionCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <Grid Margin="0,0,0,15">
                            <StackPanel>
                                <TextBlock Text="Modes de lancement" FontSize="18" FontWeight="SemiBold" />
                                <TextBlock Text="La flèche du bouton Lancer permettra de choisir un autre mode." Foreground="{StaticResource MutedBrush}" Margin="0,3,0,0" />
                            </StackPanel>
                            <StackPanel Orientation="Horizontal" HorizontalAlignment="Right" VerticalAlignment="Center">
                                <Button Content="+ Mode" Click="AddProfile_Click" />
                                <Button Content="Dupliquer" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="DuplicateProfile_Click" />
                            </StackPanel>
                        </Grid>
                        <Grid MinHeight="430">
                            <Grid.ColumnDefinitions><ColumnDefinition Width="230"/><ColumnDefinition Width="14"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                            <Border Background="#121B28" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="8">
                                <DockPanel>
                                    <StackPanel DockPanel.Dock="Bottom" Margin="0,8,0,0">
                                        <Button Content="★ Définir par défaut" Style="{StaticResource SecondaryButton}" Click="SetDefaultProfile_Click" />
                                        <Grid Margin="0,7,0,0">
                                            <Grid.ColumnDefinitions><ColumnDefinition/><ColumnDefinition/><ColumnDefinition/></Grid.ColumnDefinitions>
                                            <Button Content="↑" Style="{StaticResource GhostButton}" Click="MoveProfileUp_Click" ToolTip="Monter" />
                                            <Button Grid.Column="1" Content="↓" Style="{StaticResource GhostButton}" Click="MoveProfileDown_Click" ToolTip="Descendre" />
                                            <Button Grid.Column="2" Content="Supprimer" Style="{StaticResource GhostButton}" Click="DeleteProfile_Click" />
                                        </Grid>
                                    </StackPanel>
                                    <ListBox x:Name="ProfilesList" Background="Transparent" BorderThickness="0" HorizontalContentAlignment="Stretch"
                                             SelectionChanged="ProfilesList_SelectionChanged">
                                        <ListBox.ItemTemplate>
                                            <DataTemplate>
                                                <Border Background="#202C3B" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="8" Padding="10" Margin="0,0,0,6">
                                                    <Grid>
                                                        <TextBlock Text="{Binding Name}" TextTrimming="CharacterEllipsis" Margin="0,0,24,0" />
                                                        <TextBlock Text="★" Foreground="#E3BD62" HorizontalAlignment="Right" Visibility="{Binding IsDefault, Converter={StaticResource BoolToVisibilityConverter}}" />
                                                    </Grid>
                                                </Border>
                                            </DataTemplate>
                                        </ListBox.ItemTemplate>
                                    </ListBox>
                                </DockPanel>
                            </Border>

                            <Border Grid.Column="2" Background="#162131" BorderBrush="{StaticResource BorderBrush}" BorderThickness="1" CornerRadius="10" Padding="18"
                                    DataContext="{Binding SelectedItem, ElementName=ProfilesList}">
                                <StackPanel>
                                    <TextBlock Text="Nom du mode *" Style="{StaticResource FieldLabel}" />
                                    <TextBox Text="{Binding Name, UpdateSourceTrigger=PropertyChanged}" MaxLength="50" />
                                    <TextBlock Text="Cible *" Style="{StaticResource FieldLabel}" Margin="0,13,0,6" />
                                    <Grid>
                                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                        <TextBox Text="{Binding TargetPath, UpdateSourceTrigger=PropertyChanged}" />
                                        <Button Grid.Column="1" Content="Parcourir" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseTarget_Click" />
                                    </Grid>
                                    <TextBlock Text="Arguments" Style="{StaticResource FieldLabel}" Margin="0,13,0,6" />
                                    <TextBox Text="{Binding Arguments, UpdateSourceTrigger=PropertyChanged}" />
                                    <TextBlock Text="Dossier de travail" Style="{StaticResource FieldLabel}" Margin="0,13,0,6" />
                                    <TextBox Text="{Binding WorkingDirectory, UpdateSourceTrigger=PropertyChanged}" />
                                    <StackPanel Orientation="Horizontal" Margin="0,10,0,0">
                                        <CheckBox Content="Exécuter en administrateur" IsChecked="{Binding RunAsAdministrator}" Margin="0,4,24,4" />
                                        <CheckBox Content="Réduire après lancement" IsChecked="{Binding MinimizeAfterLaunch}" />
                                    </StackPanel>
                                    <Grid Margin="0,16,0,8">
                                        <TextBlock Text="Accès rapides de ce mode" FontWeight="SemiBold" VerticalAlignment="Center" />
                                        <Button Content="+ Dossier" HorizontalAlignment="Right" Style="{StaticResource SecondaryButton}" Click="AddQuickAccess_Click" />
                                    </Grid>
                                    <ItemsControl ItemsSource="{Binding QuickAccessLinks}">
                                        <ItemsControl.ItemTemplate>
                                            <DataTemplate>
                                                <Grid Margin="0,0,0,7">
                                                    <Grid.ColumnDefinitions><ColumnDefinition Width="115"/><ColumnDefinition Width="8"/><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                                                    <TextBox Text="{Binding Label, UpdateSourceTrigger=PropertyChanged}" MaxLength="24" />
                                                    <TextBox Grid.Column="2" Text="{Binding Path, UpdateSourceTrigger=PropertyChanged}" />
                                                    <Button Grid.Column="3" Content="…" Width="42" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseQuickAccess_Click" />
                                                    <Button Grid.Column="4" Content="×" Width="38" Style="{StaticResource GhostButton}" Margin="3,0,0,0" Click="RemoveQuickAccess_Click" />
                                                </Grid>
                                            </DataTemplate>
                                        </ItemsControl.ItemTemplate>
                                    </ItemsControl>
                                </StackPanel>
                            </Border>
                        </Grid>
                    </StackPanel>
                </Border>

                <Border Style="{StaticResource SectionCard}" Margin="0,16,0,0">
                    <StackPanel>
                        <TextBlock Text="Apparence et classement" FontSize="17" FontWeight="SemiBold" />
                        <TextBlock Text="Logo personnalisé" Style="{StaticResource FieldLabel}" Margin="0,15,0,6" />
                        <Grid>
                            <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                            <TextBox x:Name="LogoTextBox" />
                            <Button Grid.Column="1" Content="Parcourir" Style="{StaticResource SecondaryButton}" Margin="8,0,0,0" Click="BrowseLogo_Click" />
                        </Grid>
                        <TextBlock Text="Tags" FontWeight="SemiBold" Margin="0,18,0,8" />
                        <ItemsControl x:Name="TagsItemsControl">
                            <ItemsControl.ItemsPanel><ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate></ItemsControl.ItemsPanel>
                            <ItemsControl.ItemTemplate><DataTemplate><CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,20,8"><StackPanel Orientation="Horizontal"><Border Width="9" Height="9" CornerRadius="5" Background="{Binding Tag.Color}" Margin="0,0,7,0"/><TextBlock Text="{Binding Display}"/></StackPanel></CheckBox></DataTemplate></ItemsControl.ItemTemplate>
                        </ItemsControl>
                    </StackPanel>
                </Border>
            </StackPanel>
        </ScrollViewer>

        <Border Grid.Row="2" Background="{StaticResource FooterBrush}" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,14">
            <Grid>
                <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="Tester le mode sélectionné" Style="{StaticResource SecondaryButton}" Click="Test_Click" />
                    <TextBlock x:Name="FormMessageText" Foreground="{StaticResource WarningBrush}" VerticalAlignment="Center" Margin="14,0,0,0" />
                </StackPanel>
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                    <Button Content="Enregistrer" IsDefault="True" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
