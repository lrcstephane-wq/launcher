<Window x:Class="Ideo.TopSolidLauncher.Views.CardEditorWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        Title="Raccourci" Width="760" Height="760" MinWidth="680" MinHeight="650"
        WindowStartupLocation="CenterOwner" ShowInTaskbar="False"
        AllowDrop="True" DragOver="Window_DragOver" Drop="Window_Drop">
    <Grid>
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto" />
            <RowDefinition Height="*" />
            <RowDefinition Height="Auto" />
        </Grid.RowDefinitions>

        <Border Background="#162131" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,0,0,1" Padding="26,20">
            <Grid>
                <StackPanel>
                    <TextBlock x:Name="HeadingText" Text="Nouveau raccourci" FontSize="24" FontWeight="Bold" />
                    <TextBlock Text="Glissez ici un raccourci Windows .lnk pour préremplir la commande."
                               Margin="0,5,0,0" Foreground="{StaticResource MutedBrush}" />
                </StackPanel>
                <Button Content="Importer un .lnk" HorizontalAlignment="Right" VerticalAlignment="Center"
                        Style="{StaticResource SecondaryButton}" Click="ImportShortcut_Click" />
            </Grid>
        </Border>

        <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
            <Grid Margin="26,22">
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="*" />
                    <ColumnDefinition Width="18" />
                    <ColumnDefinition Width="*" />
                </Grid.ColumnDefinitions>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                    <RowDefinition Height="Auto" />
                </Grid.RowDefinitions>

                <StackPanel Grid.ColumnSpan="3">
                    <TextBlock Text="Titre *" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox x:Name="TitleTextBox" MaxLength="80" />
                </StackPanel>
                <StackPanel Grid.Row="1" Grid.ColumnSpan="3" Margin="0,16,0,0">
                    <TextBlock Text="Description courte" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox x:Name="SubtitleTextBox" MaxLength="120" />
                </StackPanel>

                <StackPanel Grid.Row="2" Margin="0,16,0,0">
                    <TextBlock Text="Groupe *" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <ComboBox x:Name="GroupComboBox" DisplayMemberPath="Name" SelectedValuePath="Id" />
                </StackPanel>
                <StackPanel Grid.Row="2" Grid.Column="2" Margin="0,16,0,0">
                    <TextBlock Text="Couleur d'accent" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <DockPanel>
                        <Border x:Name="ColorPreview" Width="38" CornerRadius="7" Margin="0,0,8,0" />
                        <ComboBox x:Name="ColorComboBox" IsEditable="True"
                                  SelectionChanged="ColorComboBox_Changed" KeyUp="ColorComboBox_KeyUp" />
                    </DockPanel>
                </StackPanel>

                <StackPanel Grid.Row="3" Grid.ColumnSpan="3" Margin="0,16,0,0">
                    <TextBlock Text="Cible *" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="TargetTextBox" />
                        <Button Grid.Column="1" Content="Parcourir" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" Click="BrowseTarget_Click" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="4" Grid.ColumnSpan="3" Margin="0,16,0,0">
                    <TextBlock Text="Arguments" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox x:Name="ArgumentsTextBox" />
                </StackPanel>

                <StackPanel Grid.Row="5" Margin="0,16,0,0">
                    <TextBlock Text="Dossier de travail" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <TextBox x:Name="WorkingDirectoryTextBox" />
                </StackPanel>
                <StackPanel Grid.Row="5" Grid.Column="2" Margin="0,16,0,0">
                    <TextBlock Text="Logo personnalisé" FontWeight="SemiBold" Margin="0,0,0,6" />
                    <Grid>
                        <Grid.ColumnDefinitions><ColumnDefinition Width="*"/><ColumnDefinition Width="Auto"/></Grid.ColumnDefinitions>
                        <TextBox x:Name="LogoTextBox" />
                        <Button Grid.Column="1" Content="…" Width="44" Style="{StaticResource SecondaryButton}"
                                Margin="8,0,0,0" Click="BrowseLogo_Click" />
                    </Grid>
                </StackPanel>

                <StackPanel Grid.Row="6" Grid.ColumnSpan="3" Margin="0,20,0,0">
                    <TextBlock Text="Tags" FontWeight="SemiBold" FontSize="16" />
                    <TextBlock Text="Plusieurs tags peuvent être associés à la même carte."
                               Foreground="{StaticResource MutedBrush}" Margin="0,3,0,10" />
                    <ItemsControl x:Name="TagsItemsControl">
                        <ItemsControl.ItemsPanel>
                            <ItemsPanelTemplate><WrapPanel /></ItemsPanelTemplate>
                        </ItemsControl.ItemsPanel>
                        <ItemsControl.ItemTemplate>
                            <DataTemplate>
                                <CheckBox IsChecked="{Binding IsSelected}" Margin="0,0,18,8">
                                    <StackPanel Orientation="Horizontal">
                                        <Border Width="9" Height="9" CornerRadius="5" Background="{Binding Tag.Color}" Margin="0,0,7,0" />
                                        <TextBlock Text="{Binding Display}" />
                                    </StackPanel>
                                </CheckBox>
                            </DataTemplate>
                        </ItemsControl.ItemTemplate>
                    </ItemsControl>
                    <Separator Margin="0,10" Background="{StaticResource BorderBrush}" />
                    <CheckBox x:Name="RunAsAdminCheckBox" Content="Exécuter en tant qu'administrateur" />
                    <CheckBox x:Name="MinimizeCheckBox" Content="Réduire le launcher après le lancement" IsChecked="True" />
                </StackPanel>
            </Grid>
        </ScrollViewer>

        <Border Grid.Row="2" Background="#162131" BorderBrush="{StaticResource BorderBrush}" BorderThickness="0,1,0,0" Padding="22,16">
            <Grid>
                <Button Content="Tester la commande" HorizontalAlignment="Left" Style="{StaticResource SecondaryButton}" Click="Test_Click" />
                <StackPanel Orientation="Horizontal" HorizontalAlignment="Right">
                    <Button Content="Annuler" IsCancel="True" Style="{StaticResource SecondaryButton}" Margin="0,0,10,0" />
                    <Button Content="Enregistrer" IsDefault="True" Click="Save_Click" />
                </StackPanel>
            </Grid>
        </Border>
    </Grid>
</Window>
